{
    "name": "Manufacturing OEE Demo",
    "version": "1.0.0",
    "industry": "manufacturing",
    "anomaly_detection": {
        "window_size": 20,
        "threshold": 2.0,
        "target_column": "production_rate"
    },
    "oee_targets": {
        "availability": 0.90,
        "performance": 0.95,
        "quality": 0.99,
        "overall_oee": 0.85
    },
    "alerts": {
        "critical_oee_threshold": 0.65,
        "warning_oee_threshold": 0.75
    }
}
